[Unit]
Description=Dispatch the generate-podcast GitHub Actions workflow
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Header file contains a single line: "Authorization: Bearer <token>".
# Passing it via -H @file keeps the token out of the process list.
LoadCredential=github-auth-header:/etc/podcast-trigger/github-auth-header
# Each retry may create a run; workflow concurrency queues them and later runs
# exit early once today's episode exists.
ExecStart=/usr/bin/curl --silent --show-error --fail-with-body \
  --retry 5 --retry-delay 30 --retry-all-errors \
  -X POST \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  -H @%d/github-auth-header \
  -d '{"ref":"main","inputs":{"skip_publish":"false","voice_service":"elevenlabs","scheduled_release":"true","video":"false"}}' \
  https://api.github.com/repos/denolfe/hacker-news-highlights/actions/workflows/generate-podcast.yml/dispatches

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
